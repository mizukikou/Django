{
  // 使用 IntelliSense 以得知可用的屬性。
  // 暫留以檢視現有屬性的描述。
  // 如需詳細資訊，請瀏覽: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: 啟動伺服器",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py", // 👈 關鍵修改 1：強制 VS Code 永遠去執行主程式 manage.py
      "args": [
        "runserver", // 👈 關鍵修改 2：加入啟動指令
        "0.0.0.0:8080"
      ],
      "django": true, // 👈 關鍵修改 3：開啟 Django 專用優化偵錯模式
      "console": "integratedTerminal"
    }
  ]
}
